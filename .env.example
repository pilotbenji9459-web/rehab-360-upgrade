# RehabPath360 Environment Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Authentication & Session Security
# Set a unique secret in your local .env file.
JWT_SECRET=
SESSION_TIMEOUT_MINUTES=60

# Database Persistence Path
DATABASE_PATH=./data/rehabpath360.db.json

# Gemini AI API Key (Set in server environment / secrets panel)
GEMINI_API_KEY=
