  "clinical_notes": [
    {
      "id": "cn-001",
      "case_id": "RP-1042",
      "author_id": "usr-psych",
      "author_name": "Dr. Fiona Gallagher",
      "author_role": "Psychologist",
      "note_type": "psychological_evaluation",
      "confidentiality": "restricted_clinical",
      "title": "Initial Intake Psychometric & Mood Depressive Index",
      "content": "Client presents symptoms consistent with moderate adjustment reaction and social withdrawal. Elevated scores on subscale for perceived helplessness. Self-rated mood dropped across recent cycles. Recommended individualized weekly supportive sessions before re-engaging in high-stimulus group workshops.",
      "recommendations": [
        "Weekly 1-on-1 cognitive reframing sessions",
        "Monitor attendance barriers collaboratively",
        "Review antidepressant medication compliance with medical wing"
      ],
      "created_at": "2026-02-10T11:00:00.000Z",
      "institution_id": "inst-demo"
    },
    {
      "id": "cn-002",
      "case_id": "RP-1044",
      "author_id": "usr-psych",
      "author_name": "Dr. Fiona Gallagher",
      "author_role": "Psychologist",
      "note_type": "risk_assessment",
      "confidentiality": "restricted_clinical",
      "title": "De-escalation and Impulsivity Assessment",
      "content": "Trigger mapping indicates reactivity to perceived challenges from authority figures. Defensive posture noted when discussing previous non-completion. However, cognitive restructuring exercises show receptive engagement when framed around long-term independence.",
      "recommendations": [
        "Maintain at Foundation B until 4 consecutive weeks of non-conflict behaviour",
        "Targeted emotional regulation modules"
      ],
      "created_at": "2026-02-12T15:30:00.000Z",
      "institution_id": "inst-demo"
    }
