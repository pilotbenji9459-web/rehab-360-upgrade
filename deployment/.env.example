# REHABPATH360 Deployment Environment Variables
PORT=3000
NODE_ENV=production

# Set APP_MODE=deployment for clean zero-record deployment (isolated from exhibition demo)
APP_MODE=deployment

# Cryptographic token secret (Replace with high-entropy 64-char key in production)
# Set a unique, randomly generated secret for each installation.
# Never use a sample value as a production secret.
JWT_SECRET=

# Required for first-administrator setup in deployment mode.
# Generate a unique random value of at least 32 characters.
SETUP_TOKEN=
# Gemini AI API Key for Document Intake and Information Extraction
GEMINI_API_KEY=
