# REHABPATH360 Deployment Environment Variables
PORT=3000
NODE_ENV=production

# Set APP_MODE=deployment for clean zero-record deployment (isolated from exhibition demo)
APP_MODE=deployment

# Cryptographic token secret (Replace with high-entropy 64-char key in production)
JWT_SECRET=rehabpath360_production_jwt_master_secret_key_2026_isolated

# Optional: Setup token required to execute the first-admin bootstrap endpoint
# SETUP_TOKEN=secure_bootstrap_secret_change_me

# Gemini AI API Key for Document Intake and Information Extraction
GEMINI_API_KEY=
